 slip. Zero distraction.\&quot;,\&quot;🛠️ WARRANTY / CARE: 8 Months Warranty on Manufacturing Defect 📜 | No Claim on Lens Scratch ❌ or Broken Frame by Customer 🚫 | Comes with a Premium Honeycomb Zippered Hard Case 📦 for safe storage &amp;amp; travel.\&quot;],\&quot;links\&quot;:[{\&quot;url\&quot;:\&quot;/Eyewearlabs-Polarized-Sunglasses-CBARKLEYC1-L-Black/dp/B0B19R6HKH\&quot;}],\&quot;productCategory\&quot;:{\&quot;glProductGroup\&quot;:{\&quot;symbol\&quot;:\&quot;gl_apparel\&quot;},\&quot;productType\&quot;:\&quot;SUNGLASSES\&quot;,\&quot;productCategoryId\&quot;:\&quot;19307700\&quot;,\&quot;productSubcategoryId\&quot;:\&quot;19307710\&quot;},\&quot;prices\&quot;:{\&quot;mainPrice\&quot;:{\&quot;price\&quot;:{\&quot;currency\&quot;:{\&quot;amount\&quot;:1502,\&quot;currencyCode\&quot;:\&quot;INR\&quot;,\&quot;displayString\&quot;:\&quot;₹1502.0\&quot;},\&quot;currencyRange\&quot;:{},\&quot;pricePerUnit\&quot;:{\&quot;baseValueAmount\&quot;:0},\&quot;type\&quot;:\&quot;BUYING\&quot;,\&quot;label\&quot;:\&quot;Price:\&quot;,\&quot;addToCartUrl\&quot;:\&quot;https://www.amazon.in/advertising/atc?ie=UTF8&amp;token=EE4CA8D03AF91D1A4EA3736BDACF62B797402B7E&amp;time=1785316416831&amp;merchantId=A289PA4YSD1HEM&amp;asin=B0B19R6HKH&amp;program=dads&amp;adPrice=1502.00&amp;offerListingId=ovnTd%252BxQ7aeGIuRKGt5uD0eDtdjlCa2qK%252B6sXGjFAQ0onlTHl6K7VbFFEEdPRnSoqCInAcPHzs18bIbPAk9u5RffrsflqHNC8klYUWQjVZE2i4Q%252BRV3LSK5fOSpHfJ5N0MUfqqyi%252BPmKZvr%252BTZrTgBDrJ4NWdYl5kkSaC66UmlSahhZI0AoS7f2jOzZlP8UA\&quot;,\&quot;suppressedByMAP\&quot;:false},\&quot;basisPrice\&quot;:{\&quot;currency\&quot;:{\&quot;amount\&quot;:3599,\&quot;currencyCode\&quot;:\&quot;INR\&quot;,\&quot;displayString\&quot;:\&quot;₹3599.0\&quot;},\&quot;currencyRange\&quot;:{},\&quot;pricePerUnit\&quot;:{\&quot;baseValueAmount\&quot;:0},\&quot;type\&quot;:\&quot;LIST\&quot;,\&quot;label\&quot;:\&quot;M.R.P.:\&quot;,\&quot;shortLabel\&quot;:\&quot;M.R.P:\&quot;,\&quot;addToCartUrl\&quot;:\&quot;https://www.amazo