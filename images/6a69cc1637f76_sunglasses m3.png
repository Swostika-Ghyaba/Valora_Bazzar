                                                                                    <span
                                                                                            class="a-button-text a-declarative"
                                                                                            data-action="a-dropdown-button"
                                                                                            role="button"
                                                                                            aria-hidden="false">
                                                                                        <span id="onlineYearPrompt"
                                                                                              class="a-dropdown-prompt"></span>
                                                                                    </span>
